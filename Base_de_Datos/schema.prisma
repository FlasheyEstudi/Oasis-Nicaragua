  expirationAlertDays      Int      @default(90) @map("dias_alerta_vencimiento")
  deliveryFeePerKm         Float    @default(15.0) @map("tarifa_envio_por_km")
  deliveryCoverageRadiusKm Float    @default(10.0) @map("radio_cobertura_envio_km")
  defaultCashierRole       String   @default("cashier") @map("rol_cajero_defecto")
  defaultDriverRole        String   @default("delivery_driver") @map("rol_repartidor_defecto")
  notificationPrefs        Json     @default("{}") @map("preferencias_notificaciones")
  createdAt                DateTime @default(now()) @map("creado_en")
  updatedAt                DateTime @updatedAt @map("actualizado_en")

  pharmacy                 Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@map("configuraciones_farmacia")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
