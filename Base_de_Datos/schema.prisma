  tokenHash String   @map("hash_token")
  expiresAt DateTime @map("expira_en")
  isUsed    Boolean  @default(false) @map("usado")
  createdAt DateTime @default(now()) @map("creado_en")

  @@index([email])
  @@index([tokenHash])
  @@map("tokens_recuperacion_password")
}

model MedicationReminder {
  id                 String   @id @default(cuid())
  userId             String   @map("usuario_id")
  prescriptionLineId String   @map("linea_receta_id")
  medicineName       String   @map("nombre_medicamento")
  dosageInstructions String   @map("instrucciones_dosis")
  scheduledTime      String   @map("hora_programada")
  status             String   @default("pending") @map("estado")
  lastNotified       DateTime? @map("ultima_notificacion")
  createdAt          DateTime @default(now()) @map("creado_en")
  updatedAt          DateTime @updatedAt @map("actualizado_en")

  user             User             @relation("UserMedicationReminders", fields: [userId], references: [id], onDelete: Cascade)
  prescriptionLine PrescriptionLine @relation("LineMedicationReminders", fields: [prescriptionLineId], references: [id], onDelete: Cascade)

