model UserSettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique @map("usuario_id")
  theme                   String   @default("system") @map("tema")
  notificationsEnabled    Boolean  @default(true) @map("notificaciones_activadas")
  notificationPreferences Json     @default("{}") @map("preferencias_notificaciones")
  createdAt               DateTime @default(now()) @map("creado_en")
  updatedAt               DateTime @updatedAt @map("actualizado_en")

