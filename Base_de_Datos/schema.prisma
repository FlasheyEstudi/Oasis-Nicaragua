  @@map("configuraciones_usuario")
}

model ClinicSettings {
  id                  String   @id @default(cuid())
  clinicId            String   @unique @map("clinica_id")
  baseConsultationFee Float    @default(0.0) @map("tarifa_consulta_base")
  taxRate             Float    @default(0.15) @map("tasa_impuesto")
  defaultPermissions  String[] @default(["view_health_data", "buy_medicines", "schedule_appointments"]) @map("permisos_defecto")
  notificationPrefs   Json     @default("{}") @map("preferencias_notificaciones")
  insurancePartners   String[] @default([]) @map("aseguradoras_asociadas")
  hoursOfOperation    Json     @default("{}") @map("horario_operacion")
  createdAt           DateTime @default(now()) @map("creado_en")
  updatedAt           DateTime @updatedAt @map("actualizado_en")

  clinic              Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("configuraciones_clinica")
}

model PharmacySettings {
  id                       String   @id @default(cuid())
  pharmacyId               String   @unique @map("farmacia_id")
  defaultVatRate           Float    @default(0.15) @map("tasa_iva_defecto")
  ticketFooter             String?  @default("¡Gracias por su compra!") @map("pie_ticket")
  invoiceSeries            String   @default("A") @map("serie_factura")
