# =========================================================================
# OASIS NICARAGUA - FRONTEND CONFIGURATION EXAMPLE
# =========================================================================

# URL base del API real (por defecto local)
# NOTA: En red local, nuestro cliente Axios detectará automáticamente tu IP 
# de la red (p. ej. 192.168.x.x) y reescribirá 'localhost' dinámicamente.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# URL de WebSockets para seguimiento en tiempo real
# NOTA: También se resolverá dinámicamente a la IP local desde otros dispositivos.
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000

# Estilo de mapa OpenFreeMap (sin API key)
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

# WebSockets habilitados
NEXT_PUBLIC_ENABLE_WEBSOCKETS=true

# Nombre de la aplicación
NEXT_PUBLIC_APP_NAME=OASIS

# Firebase PWA Configuration (Opcional - La app funcionará con advertencias amigables si se usan placeholders)
NEXT_PUBLIC_FIREBASE_API_KEY=PLACEHOLDER_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=oasis-nicaragua.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=oasis-nicaragua
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=oasis-nicaragua.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef0123456789abcdef
NEXT_PUBLIC_FIREBASE_VAPID_KEY=PLACEHOLDER_VAPID_KEY
